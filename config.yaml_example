global:
  account_id: "123456789012" # Replace; providers and backend reject other accounts.
  aws_profile: my-aws-profile # Used by kubectl and desktop clients such as Lens.
  kubernetes_version: "1.35"
  cluster_name: demo
  bucket_name: replace-with-a-globally-unique-state-bucket
  region: us-east-1
  state_region: us-east-1
  environment: dev
  common_tags:
    Environment: dev
    Project: multi-cloud-k8s-iac
    ManagedBy: Terraform
network:
  vpc_cidr: "10.0.0.0/16"
  az_count: 3
  single_nat_gateway: false # One NAT per AZ; true trades availability for lower dev costs.
  domain: example.com
  hosted_zone_id: REPLACE_WITH_EXISTING_PUBLIC_ZONE
eks:
  admin_cidrs: [] # Private endpoint by default; add your trusted public IP/32 for local execution.
  admin_principal_arns:
    - arn:aws:iam::123456789012:role/DeploymentRole
  node_instance_types: [m6i.large, m6a.large, m5.large]
  node_capacity_type: ON_DEMAND
  node_scaling: {min: 2, desired: 2, max: 6}
  # Empty means AWS's default compatible version at creation; pin from preflight for upgrades.
  addon_versions: {}
umbrella:
  metrics_server: true
  aws_load_balancer_controller: true
  cert_manager: true
  external_dns: true
  cluster_autoscaler: true
  monitoring: true
  loki: false
platform:
  repository: "https://github.com/example/helm-umbrella-charts.git"
  commit: "0123456789abcdef0123456789abcdef01234567" # Pin a published commit containing clusters/<environment>.
  secret_name: "" # Optional existing Secret in flux-system for a private repository.
application:
  enabled: false
  repository: ""
  commit: ""
  path: ./
  secret_name: "" # Optional existing Secret in flux-system for private Git authentication.
